OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000
SCENARIO_DB_PATH=scenario_runs.sqlite3
# Session-only is the default. Local mode enables unauthenticated SQLite history;
# use it only on a trusted local instance, never as a multi-user deployment.
APP_MODE=ephemeral
# Requires APP_MODE=local and an API key. Explicitly enables external AI processing.
ENABLE_AI=false
# Public-data refresh only: set an identifying user agent with your operator contact
# before making new SEC requests. Cached/offline data does not need this setting.
# SEC_USER_AGENT=Your application name your-operator-contact@example.com

# Optional free Alpaca paper-only credentials. No account/trading endpoints are used.
# Keep keys local. End-of-day IEX data is limited to one exchange.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Personal local research only; public redistribution permission is not established.
MARKET_DATA_MODE=withheld
MARKET_HISTORY_STORE=data_cache/local_market_history
